@inherits LayoutComponentBase
@inject GatewayApiClient Api
@inject UiState Ui
@implements IDisposable

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="logo">SX</div>
            <div>Smart-X Gateway<span class="sub">IoT Mesh Ecosystem · Parts 1–3</span></div>
        </div>
        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All">🏠 <span>Gateway home</span></NavLink>
            <NavLink href="ingestion">📡 <span>Sensor Ingestion</span><span class="tag">Part 1</span></NavLink>
            <NavLink href="ingestion/register">➕ <span>Register sensor</span></NavLink>
            <NavLink href="ingestion/sensors">🗂 <span>Sensor registry</span></NavLink>
            <NavLink href="ingestion/data-structures">🧬 <span>Data structures</span></NavLink>
            <NavLink href="command-stream" Match="NavLinkMatch.All">⚡ <span>Command Stream</span>@if (_health is { PendingCriticalAlerts: > 0 } h) { <span class="badge" title="Critical alerts waiting">@h.PendingCriticalAlerts</span> }<span class="tag">Part 2</span></NavLink>
            <NavLink href="command-stream/history">📜 <span>Command history</span></NavLink>
            <NavLink href="topology" Match="NavLinkMatch.Prefix">🕸 <span>Mesh Topology</span>@if (_health is { MeshDown: > 0 } m) { <span class="badge" title="Mesh nodes down">@m.MeshDown</span> }<span class="tag">Part 3</span></NavLink>
            @if (Ui.SelectedSensorMac is { } focus)
            {
                <NavLink href="@($"topology/{Uri.EscapeDataString(focus)}")" class="sub-link" title="Last sensor you focused on">↳ <span class="mono">@focus</span></NavLink>
            }
        </nav>
        <div class="foot">
            <span class="api-dot @(_apiOk is null ? "" : _apiOk == true ? "ok" : "bad")"></span>
            @if (_apiOk == true) { <span>API online · @_runtime</span> }
            else if (_apiOk == false) { <span>API unreachable at @Api.BaseAddress</span> }
            else { <span>Checking API…</span> }
        </div>
    </aside>
    <main class="main">
        @Body
    </main>
</div>
<Toasts />

@code {
    private bool? _apiOk;
    private string _runtime = "";
    private HealthInfo? _health;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnUiChanged;
        _ = PollAsync();
        await Task.CompletedTask;
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        do
        {
            try
            {
                var h = await Api.GetHealthAsync(_cts.Token);
                _health = h;
                _apiOk = h?.Status == "ok";
                _runtime = h?.Runtime.Replace(".NET ", "net") ?? "";
            }
            catch { _apiOk = false; }
            StateHasChanged();
        } while (await timer.WaitForNextTickAsync(_cts.Token).ConfigureAwait(false) == true && !_cts.IsCancellationRequested);
    }

    private void OnUiChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() { Ui.Changed -= OnUiChanged; _cts.Cancel(); _cts.Dispose(); }
}
