    /// <summary>Part 3 feedback fix: operator says a suggestion was not useful.</summary>
    private async Task DismissSuggestion(SuggestedAction suggestion)
    {
        await SendFeedback(suggestion, SuggestionVerdict.Dismissed);
        await RefreshAsync();
    }

    private async Task SendFeedback(SuggestedAction suggestion, SuggestionVerdict verdict)
    {
        if (string.IsNullOrEmpty(suggestion.RuleKey)) return;
        try
        {
            var r = await Api.SendSuggestionFeedbackAsync(suggestion.RuleKey, verdict, _cts.Token);
            if (r.Success && verdict == SuggestionVerdict.Dismissed) Toast.Info("Suggestion dismissed", r.Value?.Message ?? "");
            else if (!r.Success) Toast.Error("Feedback not recorded", r.Error);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Toast.Error("API unreachable", ex.Message); }
    }

    private async Task AcceptSuggestion(SuggestedAction suggestion)
    {
        await SendFeedback(suggestion, SuggestionVerdict.Accepted);   // reinforce the rule behind it
        var device = _snapshot?.Devices.FirstOrDefault(d => d.MacAddress.Equals(suggestion.MacAddress, StringComparison.OrdinalIgnoreCase));

        if (suggestion.Kind == SuggestionKind.IssueCommand && suggestion.Command is { } command && device is not null)
        {
            await Issue(device, command, 3, $"Accepted suggestion: {suggestion.Trigger}");
            return;
        }

        if (device is not null)
        {
            // "Inspect" – narrow the table to the device and record the look-up like a search.
            _filter = "All";
            _search = device.Name;
            OnSearchChanged();
            Toast.Info("Showing suggested device", device.Name);
            return;
        }

        // An insight about a sensor – plot it.
        _timelineMac = suggestion.MacAddress;
        await LoadTimeline();
        Toast.Info("Plotting sensor on the timeline", suggestion.DeviceName);
    }

    // ------------------------------------------------------------------ display helpers
    private static string RowClass(SmartDevice device, bool suggested) =>
        device.InAlertState ? "row-alert" : suggested ? "row-suggested" : "";

    private static string SuggestionKey(SuggestedAction s) => $"{s.Kind}|{s.MacAddress}|{s.Command}";

    private static string SuggestionTitle(SuggestedAction s) => s.Kind switch
    {
        SuggestionKind.IssueCommand => $"{s.Command} · {s.DeviceName}",
        SuggestionKind.InspectDevice => $"Check {s.DeviceName}",
        _ => s.DeviceName
    };

    private static string AcceptLabel(SuggestedAction s) => s.Kind switch
    {
        SuggestionKind.IssueCommand => "Run",
        SuggestionKind.InspectDevice => "Show",
        _ => "View"
    };

    private static string TriggerText(SuggestedAction s) =>
        s.Support > 0
            ? $"{s.Kind} · {s.Trigger} · seen {s.Support}× · recency-weighted {s.EffectiveSupport:0.0}"
            : $"{s.Kind} · {s.Trigger}";

    private static string JumpText(CriticalAlert a) =>
        $"⚡ processed {(a.LatencyMs is { } ms ? $"{ms:0} ms" : "–")} after arrival, ahead of {a.QueuedAheadAtProcess} queued packet(s)";

    private static string HistoryMeta(CommandRecord r) =>
        $"{r.PreviousState} → {r.NewState} · priority {r.Priority} · {r.IssuedBy}{(r.Undone ? " · undone" : "")}";

    private static string LastCommandText(SmartDevice d) => d.LastCommandAt is { } at ? Age(at) : "–";

    private static string SensorOption(SensorProfile s) => $"{s.Name} · {s.MacAddress} ({s.Unit})";

    private static string TimelineOption(TimelineSensor s) => $"{s.Name} · {s.MacAddress} ({s.Points} pts)";

    private static string Limit(string text, int max) => text.Length <= max ? text : text[..max];

    private static string Age(DateTimeOffset t)
    {
        var s = Math.Max(0, (DateTimeOffset.UtcNow - t).TotalSeconds);
        return s < 60 ? $"{s:0}s ago" : s < 3600 ? $"{s / 60:0}m ago" : $"{s / 3600:0.#}h ago";
    }

    public void Dispose()
    {
        var saved = Ui.CommandStream;
        saved.Filter = _filter;
        saved.Search = _search;
        saved.Paused = _paused;
        saved.TimelineMac = _timelineMac;
        saved.SimulatorMac = _simMac;
        // Cancel only: in-flight tasks may still read _cts.Token, which throws once the source is disposed.
        _cts.Cancel();
        _searchCts?.Cancel();
    }
}
