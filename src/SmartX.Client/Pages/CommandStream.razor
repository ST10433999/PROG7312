    private async Task EmergencyStop(SmartDevice device)
    {
        _busy = true;
        try
        {
            // 1. The alert goes to the PriorityQueue (or is suppressed if the device is already faulted).
            var alert = await Api.RaiseCriticalAlertAsync(new CriticalAlert
            {
                MacAddress = device.MacAddress,
                DeviceName = device.Name,
                Severity = Severity.Critical,
                Source = AlertSource.Operator,
                Title = "Emergency stop",
                Detail = $"Operator E-STOP on {device.Name}",
                ConditionKey = $"{device.MacAddress}|estop"
            }, _cts.Token);

            // 2. The stop itself is an override like any other, so it can be undone.
            var command = await Api.IssueCommandAsync(new IssueCommandRequest
            {
                MacAddress = device.MacAddress,
                Command = CommandKind.EmergencyStop,
                Priority = 1,
                Reason = "Emergency stop"
            }, _cts.Token);

            if (!command.Success) Toast.Error("E-STOP rejected", command.Error);
            else if (alert is { DuplicateSuppressed: true }) Toast.Info("E-STOP sent – duplicate alert suppressed", $"{device.Name} is already in the active-fault HashSet.");
            else Toast.Error("E-STOP", $"{device.Name} stopped; alert raised through the PriorityQueue.");
        }
        catch (OperationCanceledException)
        {
            return;                                  // page closed while the request was in flight
        }
        catch (Exception ex)
        {
            Toast.Error("API unreachable", ex.Message);
        }
        finally
        {
            _busy = false;
        }
        await RefreshAsync();
    }

